{
  "name": "raevyou-admin",
  "version": "1.0.0",
  "description": "RaevYoU Admin",
  "author": "RaevYoU",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.raevyou.admin",
    "productName": "RaevYoU Admin",
    "files": [
      "main.js",
      "index.html",
      "icon.png",
      "package.json"
    ],
    "directories": {
      "buildResources": ".",
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}